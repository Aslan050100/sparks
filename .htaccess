# Senimen — Apache rules for Plesk hosting (Git deploy into /httpdocs)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let's Encrypt проверяет домен по http — эту папку не трогаем
  RewriteRule ^\.well-known/ - [L]

  # https + без www → https://senimenagency.kz
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://senimenagency.kz%{REQUEST_URI} [R=301,L]

  # /index.html → /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Служебные файлы из репозитория не отдаём посетителям
  RewriteRule ^(assets-src|tools|tests|node_modules)(/|$) - [R=404,L]
  RewriteRule ^(server\.js|package\.json|README\.md|_headers|\.editorconfig|\.gitignore|\.nojekyll)$ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "^404\.html$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/xml application/manifest+json image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType video/mp4 .mp4
